{%- assign wa_primary = settings.whatsapp_number_primary | default: '923204967079' -%}
{%- assign wa_primary_display = settings.whatsapp_number_primary_display | default: '+923204967079' -%}
{%- assign wa_secondary = settings.whatsapp_number_secondary | default: '923004055876' -%}
{%- assign wa_secondary_display = settings.whatsapp_number_secondary_display | default: '+923004055876' -%}
{%- assign shipping_policy_url = shop.shipping_policy.url | default: '/policies/shipping-policy' -%}
{%- assign refund_policy_url = shop.refund_policy.url | default: '/policies/refund-policy' -%}
{%- assign privacy_policy_url = shop.privacy_policy.url | default: '/policies/privacy-policy' -%}
{%- assign terms_policy_url = shop.terms_of_service.url | default: '/policies/terms-of-service' -%}

<header class="site-header" role="banner">
  <div class="header-inner">
    <button class="mobile-toggle" type="button" aria-label="Open Navigation Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="header-nav" role="navigation">
        <a href="/" class="nav-link">Home</a>

        <div class="nav-item-dropdown">
          <a href="/collections/all" class="nav-link">
            Collections <span style="font-size: 0.75rem;">▾</span>
          </a>
          <div class="dropdown-menu">
            <a href="/collections/all" class="dropdown-item"><strong>All Products (13)</strong></a>
            <div style="padding: 6px 16px 2px; font-size: 0.72rem; text-transform: uppercase; color: var(--color-muted); font-weight: 700; letter-spacing: 0.05em;">Center Tables & Sets</div>
            <a href="/products/fluted-pillar-center-table" class="dropdown-item">Fluted Pillar Center Table</a>
            <a href="/products/oval-ribbed-center-table" class="dropdown-item">Oval Ribbed Center Table</a>
            <a href="/products/stepped-multitier-center-table" class="dropdown-item">Stepped Multi-Tier Table</a>
            <a href="/products/geometric-spiral-center-table" class="dropdown-item">Geometric Spiral Center Table</a>
            <a href="/products/birdcage-nesting-center-table-set" class="dropdown-item">Birdcage 3-Piece Nesting Set (CTS1)</a>
            <a href="/products/bowed-cage-nesting-center-table-set" class="dropdown-item">Bowed Cage 3-Piece Set (CTS2)</a>
            <a href="/products/crescent-nesting-center-table-set" class="dropdown-item">Crescent 3-Piece Set (CTS3)</a>
            <div style="padding: 6px 16px 2px; font-size: 0.72rem; text-transform: uppercase; color: var(--color-muted); font-weight: 700; letter-spacing: 0.05em;">Console Tables</div>
            <a href="/products/gold-wheel-console" class="dropdown-item">Gold Wheel Console</a>
            <a href="/products/black-xframe-console" class="dropdown-item">Black Top X-Frame Console</a>
            <a href="/products/sunburst-console-table" class="dropdown-item">Sunburst Gold Console</a>
            <a href="/products/white-lattice-console" class="dropdown-item">White Top Lattice Console</a>
            <div style="padding: 6px 16px 2px; font-size: 0.72rem; text-transform: uppercase; color: var(--color-muted); font-weight: 700; letter-spacing: 0.05em;">Coffee & Accent Tables</div>
            <a href="/products/mini-coffee-table" class="dropdown-item">Mini Coffee Table</a>
            <a href="/products/hourglass-mini-coffee-table" class="dropdown-item">Hourglass Fluted Mini Table (MCT2)</a>
          </div>
        </div>

        <a href="/collections/all" class="nav-link">All Products</a>

        <div class="nav-item-dropdown">
          <a href="{{ shipping_policy_url }}" class="nav-link">
            Policies <span style="font-size: 0.75rem;">▾</span>
          </a>
          <div class="dropdown-menu">
            <a href="{{ shipping_policy_url }}" class="dropdown-item">Shipping & Delivery</a>
            <a href="{{ refund_policy_url }}" class="dropdown-item">Refund & Returns</a>
            <a href="{{ privacy_policy_url }}" class="dropdown-item">Privacy Policy</a>
            <a href="{{ terms_policy_url }}" class="dropdown-item">Terms of Service</a>
          </div>
        </div>

        <a href="/pages/contact" class="nav-link">Contact Us</a>
    </nav>
    <a href="/" class="header-brand" aria-label="Gull e Gulzar Home Trolley — Home">
      <img src="{{ 'brand-logo.jpg' | asset_url }}" alt="Gull e Gulzar Home Trolley" width="120" height="120">
    </a>
    <div class="header-actions">
      <a href="/search" class="header-action-btn" aria-label="Search">
        {% render 'icon-search' %}
      </a>
      <a href="/cart" class="header-action-btn" aria-label="Shopping Cart">
        {% render 'icon-cart' %}
        <span class="badge-count">{{ cart.item_count | default: 0 }}</span>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation Menu">
  <div class="mobile-drawer-header">
    <div class="header-brand">
      <span class="brand-title" style="font-size: 1.4rem;">Gull e Gulzar</span>
      <span class="brand-tagline">Home Trolley</span>
    </div>
    <button class="mobile-drawer-close" aria-label="Close Navigation Menu">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="mobile-drawer-body">
    <nav class="mobile-nav-list">
      <a href="/" class="mobile-nav-link">Home</a>
      <a href="/collections/all" class="mobile-nav-link">Browse All Products (13)</a>
      <div style="padding: 10px 0 2px 0; font-size: 0.72rem; text-transform: uppercase; color: var(--color-muted); font-weight: 700; letter-spacing: 0.05em;">Center Tables & Sets</div>
      <a href="/products/fluted-pillar-center-table" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Fluted Pillar Center Table</a>
      <a href="/products/oval-ribbed-center-table" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Oval Ribbed Center Table</a>
      <a href="/products/stepped-multitier-center-table" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Stepped Multi-Tier Table</a>
      <a href="/products/geometric-spiral-center-table" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Geometric Spiral Center Table</a>
      <a href="/products/birdcage-nesting-center-table-set" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Birdcage 3-Piece Set (CTS1)</a>
      <a href="/products/bowed-cage-nesting-center-table-set" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Bowed Cage 3-Piece Set (CTS2)</a>
      <a href="/products/crescent-nesting-center-table-set" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Crescent 3-Piece Set (CTS3)</a>
      <div style="padding: 10px 0 2px 0; font-size: 0.72rem; text-transform: uppercase; color: var(--color-muted); font-weight: 700; letter-spacing: 0.05em;">Console Tables</div>
      <a href="/products/gold-wheel-console" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Gold Wheel Console</a>
      <a href="/products/black-xframe-console" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Black Top X-Frame Console</a>
      <a href="/products/sunburst-console-table" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Sunburst Gold Console</a>
      <a href="/products/white-lattice-console" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">White Top Lattice Console</a>
      <div style="padding: 10px 0 2px 0; font-size: 0.72rem; text-transform: uppercase; color: var(--color-muted); font-weight: 700; letter-spacing: 0.05em;">Coffee & Accent Tables</div>
      <a href="/products/mini-coffee-table" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Mini Coffee Table</a>
      <a href="/products/hourglass-mini-coffee-table" class="mobile-nav-link" style="padding-left: 0.75rem; font-size: 0.95rem;">Hourglass Fluted Mini Table (MCT2)</a>
      <div style="padding: 10px 0 2px 0; font-size: 0.72rem; text-transform: uppercase; color: var(--color-muted); font-weight: 700; letter-spacing: 0.05em;">Information</div>
      <a href="/pages/contact" class="mobile-nav-link">Contact Us</a>
      <a href="{{ shipping_policy_url }}" class="mobile-nav-link">Shipping Policy</a>
      <a href="{{ refund_policy_url }}" class="mobile-nav-link">Refund & Returns</a>
      <a href="{{ privacy_policy_url }}" class="mobile-nav-link">Privacy Policy</a>
      <a href="{{ terms_policy_url }}" class="mobile-nav-link">Terms of Service</a>
    </nav>
  </div>

  <div class="mobile-drawer-footer">
    <p style="font-size: 0.8rem; font-weight: 600; color: var(--color-muted); margin-bottom: 0.6rem; text-transform: uppercase;">
      Direct WhatsApp Support
    </p>
    <a href="https://wa.me/{{ wa_primary }}?text={{ 'Hello Gull e Gulzar, I would like to inquire about your products.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm btn-block" style="margin-bottom: 0.5rem;">
      {% render 'icon-whatsapp' %} {{ wa_primary_display }} (Primary)
    </a>
    <a href="https://wa.me/{{ wa_secondary }}?text={{ 'Hello Gull e Gulzar, I would like to inquire about your products.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm btn-block" style="border-color: #25D366; color: #128C7E;">
      {% render 'icon-whatsapp' %} {{ wa_secondary_display }} (Support)
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
