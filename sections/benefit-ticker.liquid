<section class="benefit-ticker" aria-label="Store benefits">
  <div class="ticker-track">
    <div class="ticker-group">
      <span>{{ section.settings.message_one | default: '24/7 Customer Support' }}</span><span aria-hidden="true">✦</span>
      <span>{{ section.settings.message_two | default: 'Furniture Elegance' }}</span><span aria-hidden="true">✦</span>
      <span>{{ section.settings.message_three | default: 'Free Delivery Across Pakistan' }}</span><span aria-hidden="true">✦</span>
      <span>{{ section.settings.message_four | default: 'Gull e Gulzar Home Trolley' }}</span><span aria-hidden="true">✦</span>
    </div>
    <div class="ticker-group" aria-hidden="true">
      <span>{{ section.settings.message_one | default: '24/7 Customer Support' }}</span><span>✦</span>
      <span>{{ section.settings.message_two | default: 'Furniture Elegance' }}</span><span>✦</span>
      <span>{{ section.settings.message_three | default: 'Free Delivery Across Pakistan' }}</span><span>✦</span>
      <span>{{ section.settings.message_four | default: 'Gull e Gulzar Home Trolley' }}</span><span>✦</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits ticker",
  "settings": [
    {
      "type": "text",
      "id": "message_one",
      "label": "First message",
      "default": "24/7 Customer Support"
    },
    {
      "type": "text",
      "id": "message_two",
      "label": "Second message",
      "default": "Furniture Elegance"
    },
    {
      "type": "text",
      "id": "message_three",
      "label": "Third message",
      "default": "Free Delivery Across Pakistan"
    },
    {
      "type": "text",
      "id": "message_four",
      "label": "Fourth message",
      "default": "Gull e Gulzar Home Trolley"
    }
  ],
  "presets": [
    {
      "name": "Benefits ticker"
    }
  ]
}
{% endschema %}
