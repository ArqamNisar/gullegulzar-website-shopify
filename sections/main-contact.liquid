{%- assign wa_primary = settings.whatsapp_number_primary | default: '923204967079' -%}
{%- assign wa_primary_display = settings.whatsapp_number_primary_display | default: '+923204967079' -%}
{%- assign wa_secondary = settings.whatsapp_number_secondary | default: '923004055876' -%}
{%- assign wa_secondary_display = settings.whatsapp_number_secondary_display | default: '+923004055876' -%}

<section class="page-hero contact-page-hero">
  <div class="container">
    <span class="subheading">We’re here to help</span>
    <h1>Contact Gull e Gulzar</h1>
    <p>Questions about a product, a custom design, an order, or delivery? Choose the best way to reach our team.</p>
  </div>
</section>

<section class="contact-page-content section-spacing">
  <div class="container">
    <div class="contact-channel-grid">
      <a class="contact-channel-card" href="https://wa.me/{{ wa_primary }}?text={{ 'Hello Gull e Gulzar Home Trolley, I have a question about a product or order.' | url_encode }}" target="_blank" rel="noopener noreferrer">
        <span class="contact-channel-icon">{% render 'icon-whatsapp' %}</span>
        <span class="contact-channel-label">Orders & product questions</span>
        <strong>{{ wa_primary_display }}</strong>
        <span class="contact-channel-action">Message us on WhatsApp <span aria-hidden="true">→</span></span>
      </a>
      <a class="contact-channel-card" href="https://wa.me/{{ wa_secondary }}?text={{ 'Hello Gull e Gulzar Home Trolley, I need help with customer support or delivery.' | url_encode }}" target="_blank" rel="noopener noreferrer">
        <span class="contact-channel-icon">{% render 'icon-phone' %}</span>
        <span class="contact-channel-label">Customer support & delivery</span>
        <strong>{{ wa_secondary_display }}</strong>
        <span class="contact-channel-action">Message our support team <span aria-hidden="true">→</span></span>
      </a>
      <a class="contact-channel-card" href="mailto:{{ section.settings.support_email | default: 'gullegulzarhometrolley@gmail.com' | escape }}">
        <span class="contact-channel-icon contact-email-icon" aria-hidden="true">✉</span>
        <span class="contact-channel-label">Email</span>
        <strong>{{ section.settings.support_email | default: 'gullegulzarhometrolley@gmail.com' | escape }}</strong>
        <span class="contact-channel-action">Send us an email <span aria-hidden="true">→</span></span>
      </a>
    </div>

    <div class="contact-message-layout">
      <div class="contact-form-card">
        <span class="subheading">Send a message</span>
        <h2>How can we help?</h2>
        <p>Share a few details and our team will follow up using the contact information you provide.</p>

        {% form 'contact', id: 'ContactPageForm' %}
          {%- if form.posted_successfully? -%}
            <div class="contact-form-notice contact-form-success" role="status">Thank you for reaching out. We have received your message.</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="contact-form-notice contact-form-error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="contact-form-fields">
            <div class="contact-form-field">
              <label for="ContactFormName">Name</label>
              <input id="ContactFormName" type="text" name="contact[name]" autocomplete="name" required>
            </div>
            <div class="contact-form-field">
              <label for="ContactFormPhone">Phone / WhatsApp</label>
              <input id="ContactFormPhone" type="tel" name="contact[phone]" autocomplete="tel" required>
            </div>
            <div class="contact-form-field contact-form-field-wide">
              <label for="ContactFormEmail">Email</label>
              <input id="ContactFormEmail" type="email" name="contact[email]" autocomplete="email" required>
            </div>
            <div class="contact-form-field contact-form-field-wide">
              <label for="ContactFormBody">Message</label>
              <textarea id="ContactFormBody" name="contact[body]" rows="5" required></textarea>
            </div>
          </div>
          <button type="submit" class="btn btn-primary contact-submit-button">Send inquiry <span aria-hidden="true">→</span></button>
        {% endform %}
      </div>

      <aside class="contact-information-card">
        <span class="contact-info-mark" aria-hidden="true">✦</span>
        <span class="subheading">Gull e Gulzar Home Trolley</span>
        <h2>A thoughtful piece starts with a conversation.</h2>
        <p>Our team can help you with product details, custom furniture questions, order updates, and delivery support.</p>
        <div class="contact-info-detail">
          <strong>Delivery</strong>
          <span>Free delivery across Pakistan. See our <a href="/pages/shipping-policy">Shipping Policy</a> for delivery estimates.</span>
        </div>
        <div class="contact-info-detail">
          <strong>Support</strong>
          <span>Choose either WhatsApp number above and include your order details when asking about an existing order.</span>
        </div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "gullegulzarhometrolley@gmail.com"
    }
  ]
}
{% endschema %}
