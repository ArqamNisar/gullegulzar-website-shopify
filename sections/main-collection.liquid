{%- assign mini_product = all_products['mini-coffee-table'] -%}
{%- assign console_a = all_products['gold-wheel-console'] -%}
{%- assign console_b = all_products['black-xframe-console'] -%}
{%- assign console_c = all_products['sunburst-console-table'] -%}
{%- assign console_d = all_products['white-lattice-console'] -%}

<section class="page-hero collection-page-hero">
  <div class="container">
    <span class="subheading">Thoughtfully chosen</span>
    <h1>Our Collection</h1>
    <p>Explore console tables and accent furniture designed to bring warmth and everyday elegance to your home.</p>
  </div>
</section>

<section class="section-spacing search-results-section">
  <div class="container">
    <div class="products-grid">
      {%- if mini_product != blank -%}
        {% render 'product-card', product: mini_product, category: 'Mini Coffee Table', image_filename: 'mini-room.jpg' %}
      {%- else -%}
        {% render 'product-card',
          title: 'Mini Coffee Table',
          category: 'Mini Coffee Table',
          price: 'Rs. 6,000',
          compare_price: 'Rs. 7,000',
          image_filename: 'mini-room.jpg',
          url: '/products/mini-coffee-table',
        %}
      {%- endif -%}
      {%- if console_a != blank -%}
        {% render 'product-card', product: console_a, category: 'Console Tables', image_filename: 'console-a2.jpg' %}
      {%- else -%}
        {% render 'product-card', title: 'Gold Wheel Console Trolley', category: 'Console Tables', price: 'Rs. 13,000', compare_price: 'Rs. 15,000', image_filename: 'console-a2.jpg', url: '/products/gold-wheel-console' %}
      {%- endif -%}
      {%- if console_b != blank -%}
        {% render 'product-card', product: console_b, category: 'Console Tables', image_filename: 'console-b.jpg' %}
      {%- else -%}
        {% render 'product-card', title: 'Black Top X-Frame Console Table', category: 'Console Tables', price: 'Rs. 13,000', compare_price: 'Rs. 15,000', image_filename: 'console-b.jpg', url: '/products/black-xframe-console' %}
      {%- endif -%}
      {%- if console_c != blank -%}
        {% render 'product-card', product: console_c, category: 'Console Tables', image_filename: 'console-c2.jpg' %}
      {%- else -%}
        {% render 'product-card', title: 'Sunburst Gold Console Table', category: 'Console Tables', price: 'Rs. 13,000', compare_price: 'Rs. 15,000', image_filename: 'console-c2.jpg', url: '/products/sunburst-console-table' %}
      {%- endif -%}
      {%- if console_d != blank -%}
        {% render 'product-card', product: console_d, category: 'Console Tables', image_filename: 'console-d.jpg' %}
      {%- else -%}
        {% render 'product-card', title: 'White Top Lattice Console Table', category: 'Console Tables', price: 'Rs. 13,000', compare_price: 'Rs. 15,000', image_filename: 'console-d.jpg', url: '/products/white-lattice-console' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Page",
  "settings": []
}
{% endschema %}
