{%- assign mini_product = all_products['mini-coffee-table'] -%}
{%- assign mini_image = 'mini-coffee.jpg' | asset_url -%}

<section class="page-hero collection-page-hero">
  <div class="container">
    <span class="subheading">Thoughtfully chosen</span>
    <h1>Our Collection</h1>
    <p>Discover the Mini Coffee Table, made to bring a touch of warmth and everyday elegance to your home.</p>
  </div>
</section>

<section class="section-spacing search-results-section">
  <div class="container">
    <div class="products-grid featured-single-product">
      {%- if mini_product != blank -%}
        {% render 'product-card', product: mini_product, category: 'Mini Coffee Table' %}
      {%- else -%}
        {% render 'product-card',
          title: 'Mini Coffee Table',
          category: 'Mini Coffee Table',
          price: 'Rs. 5,500',
          image_url: mini_image,
          url: '/products/mini-coffee-table',
          badge: 'New'
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Page",
  "settings": []
}
{% endschema %}
