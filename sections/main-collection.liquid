{%- assign collection_title = collection.title | default: 'All Collections & Living Tables' -%}

<div class="contact-hero">
  <div class="container">
    <span class="subheading">Gull e Gulzar Catalog</span>
    <h1 style="font-size: 2.8rem; margin-bottom: 0.5rem;">{{ collection_title }}</h1>
    <p style="max-width: 600px; margin: 0 auto; color: var(--color-body);">
      Explore our handcrafted luxury furniture, manufactured in Pakistan with the highest standards of materials and design.
    </p>
  </div>
</div>

<div class="section-spacing" style="background: var(--color-bg-body);">
  <div class="container">
    <!-- Category Quick Filter Bar -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; margin-bottom: 3rem;">
      <a href="/collections/all" class="btn btn-sm btn-dark">All Products</a>
      <a href="/collections/tea-trolleys" class="btn btn-sm btn-outline">Tea Trolleys</a>
      <a href="/collections/coffee-tables" class="btn btn-sm btn-outline">Coffee Tables</a>
      <a href="/collections/center-tables" class="btn btn-sm btn-outline">Center Tables</a>
      <a href="/collections/mini-coffee-tables" class="btn btn-sm btn-outline">Mini Coffee Tables</a>
      <a href="/collections/nesting-sets" class="btn btn-sm btn-outline">Nesting Sets</a>
      <a href="/collections/center-table-sets" class="btn btn-sm btn-outline">Center Table Sets</a>
      <a href="/collections/table-sets" class="btn btn-sm btn-outline">Table Sets</a>
      <a href="/collections/console-tables" class="btn btn-sm btn-outline">Console Tables</a>
      <a href="/collections/tea-tables" class="btn btn-sm btn-outline">Tea Tables</a>
    </div>

    <!-- Product Grid -->
    <div class="products-grid">
      {%- if collection.products.size > 0 -%}
        {%- for prod in collection.products -%}
          {% render 'product-card', product: prod %}
        {%- endfor -%}
      {%- else -%}
        <!-- Curated Full Showcase -->
        {% render 'product-card',
          title: 'Royal 2-Tier Gold Tea Trolley',
          category: 'Tea Trolleys',
          price: 'Rs. 24,500',
          compare_price: 'Rs. 29,000',
          image_url: 'https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?auto=format&fit=crop&w=700&q=80',
          badge: 'Bestseller'
        %}

        {% render 'product-card',
          title: 'Imperial Round Nesting Set (3-Piece)',
          category: 'Nesting Set',
          price: 'Rs. 32,000',
          compare_price: 'Rs. 38,000',
          image_url: 'https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=700&q=80',
          badge: 'Signature'
        %}

        {% render 'product-card',
          title: 'Fluted Brass Center Table',
          category: 'Center Table',
          price: 'Rs. 28,500',
          compare_price: 'Rs. 34,000',
          image_url: 'https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=700&q=80',
          badge: 'Trending'
        %}

        {% render 'product-card',
          title: 'Geometric Marble Center Table Set',
          category: 'Center Table Set',
          price: 'Rs. 42,000',
          compare_price: 'Rs. 48,000',
          image_url: 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=700&q=80',
          badge: 'Luxury Set'
        %}

        {% render 'product-card',
          title: 'Modernist Sleek Coffee Table',
          category: 'Coffee Tables',
          price: 'Rs. 19,500',
          compare_price: 'Rs. 23,000',
          image_url: 'https://images.unsplash.com/photo-1533090161767-e6ffed986c88?auto=format&fit=crop&w=700&q=80',
          badge: 'Popular'
        %}

        {% render 'product-card',
          title: 'Aura Compact Mini Coffee Table',
          category: 'Mini Coffee Table',
          price: 'Rs. 14,000',
          compare_price: 'Rs. 16,500',
          image_url: 'https://images.unsplash.com/photo-1532323544230-7191fd51bc1b?auto=format&fit=crop&w=700&q=80',
          badge: 'Compact'
        %}

        {% render 'product-card',
          title: 'Monarch Grand Foyer Console Table',
          category: 'Console Tables',
          price: 'Rs. 36,000',
          compare_price: 'Rs. 42,000',
          image_url: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=700&q=80',
          badge: 'New'
        %}

        {% render 'product-card',
          title: 'Artisan Glass & Wood Tea Table',
          category: 'Tea Tables',
          price: 'Rs. 18,500',
          compare_price: 'Rs. 22,000',
          image_url: 'https://images.unsplash.com/photo-1519974719765-e6559eac2575?auto=format&fit=crop&w=700&q=80',
          badge: 'Artisan'
        %}

        {% render 'product-card',
          title: 'Sculptural Marble Top Table Set (4-Piece)',
          category: 'Table Set',
          price: 'Rs. 58,000',
          compare_price: 'Rs. 68,000',
          image_url: 'https://images.unsplash.com/photo-1592078615290-033ee584e267?auto=format&fit=crop&w=700&q=80',
          badge: 'Exclusive'
        %}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Page",
  "settings": []
}
{% endschema %}
