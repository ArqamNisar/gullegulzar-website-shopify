{%- assign mini_product = all_products['mini-coffee-table'] -%}
{%- assign mini_image = 'mini-coffee.jpg' | asset_url -%}

<section class="section-spacing featured-products-section">
  <div class="container">
    <div class="section-heading-row">
      <div class="section-header">
        <span class="subheading">A little something special</span>
        <h2>{{ section.settings.heading | default: 'Featured Collection' }}</h2>
        <p>{{ section.settings.description | default: 'Meet the Mini Coffee Table, thoughtfully styled for everyday living.' }}</p>
      </div>
    </div>

    <div class="products-grid featured-single-product">
      {%- if mini_product != blank -%}
        {% render 'product-card', product: mini_product, category: 'Mini Coffee Table' %}
      {%- else -%}
        {% render 'product-card',
          title: 'Mini Coffee Table',
          category: 'Mini Coffee Table',
          price: 'Rs. 5,500',
          image_url: mini_image,
          url: '/products/mini-coffee-table',
          badge: 'New'
        %}
      {%- endif -%}
    </div>

    <div class="section-cta">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-primary">
        {{ section.settings.button_label | default: 'Explore Collections' }}
        {% render 'icon-arrow' %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Meet the Mini Coffee Table, thoughtfully styled for everyday living."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
