<section class="home-banner" aria-label="Gull e Gulzar Home Trolley">
  {% if section.settings.banner_image != blank %}
    {{ section.settings.banner_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.image_alt }}
  {% else %}
    <img src="{{ 'home-hero.jpg' | asset_url }}" alt="{{ section.settings.image_alt | default: 'Gull e Gulzar Home Trolley luxury furniture and nationwide delivery' | escape }}" width="1536" height="864" fetchpriority="high">
  {% endif %}
</section>

{% schema %}
{
  "name": "Home hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Gull e Gulzar Home Trolley luxury furniture and nationwide delivery"
    }
  ],
  "presets": [
    {
      "name": "Home hero banner"
    }
  ]
}
{% endschema %}
