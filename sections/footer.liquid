<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-column footer-about">
        <h2>About us</h2>
        <p class="footer-desc">{{ section.settings.about_text | default: 'Gull e Gulzar Home Trolley offers elegant, thoughtfully crafted furniture to bring comfort and timeless style to your home. Discover beautiful tea trolleys, tables, and furniture made with care.' }}</p>
        <p class="footer-about-closing">Discover your perfect piece and make every moment count with <strong>Gull e Gulzar Home Trolley.</strong></p>
        <div class="footer-social-links" aria-label="Social media">
          <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/' }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="18" cy="6" r="0.8" class="social-fill"></circle></svg>
          </a>
          <a href="{{ section.settings.facebook_url | default: 'https://www.facebook.com/' }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3a5 5 0 0 0-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9a1 1 0 0 1 1-1z"></path></svg>
          </a>
          <a href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com/' }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.2a4 4 0 1 1-3-3.9V7.2a8 8 0 1 0 7 7.9V9.4a9 9 0 0 0 4 1V6.8A5 5 0 0 1 17 3h-3z"></path></svg>
          </a>
        </div>
      </div>

      <div class="footer-column">
        <h2>Main Menu</h2>
        <ul class="footer-links">
          <li><a href="{{ routes.root_url }}" class="footer-link">Home</a></li>
          <li><a href="/collections/all" class="footer-link">Featured Collection</a></li>
          <li><a href="/collections/all" class="footer-link">All Collections</a></li>
          <li><a href="/pages/contact" class="footer-link">Contact</a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h2>Policy</h2>
        <ul class="footer-links">
          <li><a href="/search" class="footer-link">Search</a></li>
          <li><a href="{{ shop.policies.terms_of_service.url | default: '/pages/terms-of-service' }}" class="footer-link">Terms of Service</a></li>
          <li><a href="{{ shop.policies.shipping_policy.url | default: '/pages/shipping-policy' }}" class="footer-link">Shipping Policy</a></li>
          <li><a href="{{ shop.policies.refund_policy.url | default: '/pages/refund-policy' }}" class="footer-link">Refund Policy</a></li>
          <li><a href="{{ shop.policies.privacy_policy.url | default: '/pages/privacy-policy' }}" class="footer-link">Privacy Policy</a></li>
          <li><a href="/pages/terms-of-service" class="footer-link">Legal Notice</a></li>
          <li><a href="/pages/contact" class="footer-link">Contact Information</a></li>
        </ul>
      </div>

      <div class="footer-column footer-help">
        <h2>Need Help?</h2>
        <p class="footer-desc">We are happy to help and assist you.</p>
        {% if section.settings.contact_email != blank %}
          <p class="footer-help-detail"><strong>Email:</strong> <a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a></p>
        {% endif %}
        <p class="footer-help-detail"><strong>Timing:</strong> {{ section.settings.support_hours | default: '24/7 Support' }}</p>
        <a class="footer-link" href="/pages/contact">Contact Us</a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} <strong>Gull e Gulzar Home Trolley</strong>. All rights reserved.
      </div>
      <span>Furniture for beautiful living.</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook page"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok profile"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About us",
      "default": "Gull e Gulzar Home Trolley offers elegant, thoughtfully crafted furniture to bring comfort and timeless style to your home. Discover beautiful tea trolleys, tables, and furniture made with care."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Support email"
    },
    {
      "type": "text",
      "id": "support_hours",
      "label": "Support hours",
      "default": "24/7 Support"
    }
  ]
}
{% endschema %}
