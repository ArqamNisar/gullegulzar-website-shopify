{%- assign wa_primary = settings.whatsapp_number_primary | default: '923204967079' -%}
{%- assign wa_primary_display = settings.whatsapp_number_primary_display | default: '+923204967079' -%}
{%- assign wa_secondary = settings.whatsapp_number_secondary | default: '923004055876' -%}
{%- assign wa_secondary_display = settings.whatsapp_number_secondary_display | default: '+923004055876' -%}

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-column">
        <h3 class="footer-brand-title">Gull e Gulzar</h3>
        <span class="footer-brand-tagline">Home Trolley & Luxury Tables</span>
        <p class="footer-desc">
          Specializing in exquisite tea trolleys, center tables, nesting sets, and console tables. Crafted with architectural passion and delivered with care across Pakistan.
        </p>
        <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
          <a href="https://wa.me/{{ wa_primary }}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" aria-label="WhatsApp Us">
            {% render 'icon-whatsapp' %} Chat on WhatsApp
          </a>
        </div>
      </div>

      <!-- Col 2: Categories -->
      <div class="footer-column">
        <h4>Our Collections</h4>
        <ul class="footer-links">
          <li><a href="/collections/tea-trolleys" class="footer-link">Tea Trolleys</a></li>
          <li><a href="/collections/coffee-tables" class="footer-link">Coffee Tables</a></li>
          <li><a href="/collections/center-tables" class="footer-link">Center Tables</a></li>
          <li><a href="/collections/mini-coffee-tables" class="footer-link">Mini Coffee Tables</a></li>
          <li><a href="/collections/nesting-sets" class="footer-link">Nesting Sets</a></li>
          <li><a href="/collections/center-table-sets" class="footer-link">Center Table Sets</a></li>
          <li><a href="/collections/table-sets" class="footer-link">Table Sets</a></li>
          <li><a href="/collections/console-tables" class="footer-link">Console Tables</a></li>
          <li><a href="/collections/tea-tables" class="footer-link">Tea Tables</a></li>
        </ul>
      </div>

      <!-- Col 3: Policies & Quick Links -->
      <div class="footer-column">
        <h4>Customer Care</h4>
        <ul class="footer-links">
          <li><a href="/pages/contact" class="footer-link">Contact Us</a></li>
          <li><a href="/pages/shipping-policy" class="footer-link">Shipping & Delivery Policy</a></li>
          <li><a href="/pages/refund-policy" class="footer-link">Refund & Return Policy</a></li>
          <li><a href="/pages/privacy-policy" class="footer-link">Privacy Policy</a></li>
          <li><a href="/pages/terms-of-service" class="footer-link">Terms of Service</a></li>
          <li><a href="/collections/all" class="footer-link">Catalog Directory</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & WhatsApp Numbers -->
      <div class="footer-column">
        <h4>Direct Contact</h4>
        <div class="footer-contact-item">
          {% render 'icon-whatsapp' %}
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-gold); display: block;">Primary Orders & WhatsApp</span>
            <a href="https://wa.me/{{ wa_primary }}?text={{ 'Hello Gull e Gulzar, I would like to inquire about your home trolleys and tables.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="footer-contact-link">
              {{ wa_primary_display }}
            </a>
          </div>
        </div>

        <div class="footer-contact-item">
          {% render 'icon-phone' %}
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-gold); display: block;">Support & Sales Line</span>
            <a href="https://wa.me/{{ wa_secondary }}?text={{ 'Hello Gull e Gulzar, I would like to inquire about your home trolleys and tables.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="footer-contact-link">
              {{ wa_secondary_display }}
            </a>
          </div>
        </div>

        <p style="font-size: 0.85rem; color: #78716C; margin-top: 1rem; line-height: 1.5;">
          📍 Delivery available across Lahore, Karachi, Islamabad, and nationwide across Pakistan.
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} <strong>Gull e Gulzar Home Trolley</strong>. All rights reserved.
      </div>
      <div style="display: flex; gap: 1.5rem;">
        <a href="/pages/privacy-policy">Privacy</a>
        <a href="/pages/refund-policy">Refunds</a>
        <a href="/pages/terms-of-service">Terms</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
