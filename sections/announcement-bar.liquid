<div class="announcement-bar" role="region" aria-label="Announcement">
  <div class="ticker-track">
    <div class="ticker-group">
      <span>{{ section.settings.text | default: 'Gull e Gulzar Home Trolley' }}</span><span aria-hidden="true">✦</span>
      <span>{{ section.settings.shipping_text | default: 'Free Shipping Across Pakistan' }}</span><span aria-hidden="true">✦</span>
      <span>{{ section.settings.sale_text | default: '11.11 Sale Coming Soon' }}</span><span aria-hidden="true">✦</span>
    </div>
    <div class="ticker-group" aria-hidden="true">
      <span>{{ section.settings.text | default: 'Gull e Gulzar Home Trolley' }}</span><span>✦</span>
      <span>{{ section.settings.shipping_text | default: 'Free Shipping Across Pakistan' }}</span><span>✦</span>
      <span>{{ section.settings.sale_text | default: '11.11 Sale Coming Soon' }}</span><span>✦</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Store name",
      "default": "Gull e Gulzar Home Trolley"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping message",
      "default": "Free Shipping Across Pakistan"
    },
    {
      "type": "text",
      "id": "sale_text",
      "label": "Promotion message",
      "default": "11.11 Sale Coming Soon"
    }
  ]
}
{% endschema %}
