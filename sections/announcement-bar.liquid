{%- assign wa_primary = settings.whatsapp_number_primary | default: '923204967079' -%}
{%- assign wa_primary_display = settings.whatsapp_number_primary_display | default: '+923204967079' -%}
{%- assign wa_secondary = settings.whatsapp_number_secondary | default: '923004055876' -%}
{%- assign wa_secondary_display = settings.whatsapp_number_secondary_display | default: '+923004055876' -%}

<div class="announcement-bar" role="region" aria-label="Announcement">
  <div class="container">
    <div class="announcement-content">
      <span>✨</span>
      <span>{{ section.settings.text | default: '✦ Luxury Home Trolleys & Living Tables | Handcrafted Custom Designs | Safe Nationwide Delivery ✦' }}</span>
    </div>

    <div class="announcement-actions">
      <span>Direct WhatsApp:</span>
      <a href="https://wa.me/{{ wa_primary }}?text={{ 'Hello Gull e Gulzar, I would like to inquire about your products' | url_encode }}" target="_blank" rel="noopener noreferrer" class="announcement-phone">
        {% render 'icon-whatsapp' %} {{ wa_primary_display }}
      </a>
      <span>|</span>
      <a href="https://wa.me/{{ wa_secondary }}?text={{ 'Hello Gull e Gulzar, I would like to inquire about your products' | url_encode }}" target="_blank" rel="noopener noreferrer" class="announcement-phone">
        {% render 'icon-whatsapp' %} {{ wa_secondary_display }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "✦ Luxury Home Trolleys & Living Tables | Handcrafted Custom Designs | Safe Nationwide Delivery ✦"
    }
  ]
}
{% endschema %}
