<section class="section-spacing features-section">
  <div class="container">
    <div class="section-header">
      <span class="subheading">The Gull e Gulzar Difference</span>
      <h2>Artistry, Strength & Bespoke Excellence</h2>
      <p>Every piece that leaves our workshop is built to stand the test of time, blending aesthetic sophistication with rugged durability.</p>
    </div>

    <div class="features-grid">
      <!-- Feature 1 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-craft' %}
        </div>
        <h4>Artisanal Craftsmanship</h4>
        <p>Expert metal fabricators and polishers ensure seamless joints, mirror-shine coatings, and enduring structure.</p>
      </div>

      <!-- Feature 2 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-customize' %}
        </div>
        <h4>Custom Dimensions</h4>
        <p>Have a specific corner or interior theme? Customize sizes, metal plating colors, and table top materials effortlessly.</p>
      </div>

      <!-- Feature 3 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-shield' %}
        </div>
        <h4>Factory Direct Quality</h4>
        <p>Premium architectural grade materials at honest, manufacturer-direct prices without unnecessary retail markups.</p>
      </div>

      <!-- Feature 4 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-truck' %}
        </div>
        <h4>Nationwide Safe Delivery</h4>
        <p>Rigorous multi-layer foam and wooden crate packing delivering safely to Lahore, Karachi, Islamabad & across Pakistan.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value Highlights",
  "settings": [],
  "presets": [
    {
      "name": "Value Highlights"
    }
  ]
}
{% endschema %}
