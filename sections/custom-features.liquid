<section class="section-spacing features-section">
  <div class="container">
    <div class="section-heading-row">
      <div class="section-header">
        <span class="subheading">Made with care, made to last</span>
        <h2>{{ section.settings.heading | default: 'The beauty is in the details' }}</h2>
        <p>{{ section.settings.description | default: 'Discover the thoughtful details and considered materials behind every piece.' }}</p>
      </div>
      <div class="carousel-controls" aria-label="Craftsmanship highlights controls">
        <button class="carousel-button" type="button" data-carousel-prev aria-label="Scroll highlights left">{% render 'icon-arrow' %}</button>
        <button class="carousel-button carousel-button-next" type="button" data-carousel-next aria-label="Scroll highlights right">{% render 'icon-arrow' %}</button>
      </div>
    </div>

    <div class="features-grid horizontal-carousel" data-horizontal-carousel tabindex="0" aria-label="Furniture quality highlights">
      <!-- Feature 1 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-craft' %}
        </div>
        <h4>Artisanal Craftsmanship</h4>
        <p>Expert metal fabricators and polishers ensure seamless joints, mirror-shine coatings, and enduring structure.</p>
      </div>

      <!-- Feature 2 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-customize' %}
        </div>
        <h4>Custom Dimensions</h4>
        <p>Have a specific corner or interior theme? Customize sizes, metal plating colors, and table top materials effortlessly.</p>
      </div>

      <!-- Feature 3 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-shield' %}
        </div>
        <h4>Factory Direct Quality</h4>
        <p>Premium architectural grade materials at honest, manufacturer-direct prices without unnecessary retail markups.</p>
      </div>

      <!-- Feature 4 -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          {% render 'icon-truck' %}
        </div>
        <h4>Nationwide Safe Delivery</h4>
        <p>Rigorous multi-layer foam and wooden crate packing delivering safely to Lahore, Karachi, Islamabad & across Pakistan.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value Highlights",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The beauty is in the details"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover the thoughtful details and considered materials behind every piece."
    }
  ],
  "presets": [
    {
      "name": "Value Highlights"
    }
  ]
}
{% endschema %}
