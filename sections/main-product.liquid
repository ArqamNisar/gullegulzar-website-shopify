          {%- else -%}
            <strong>4.9</strong>
            <span class="product-rating-stars" aria-label="4.9 out of 5 stars">★★★★★</span>
            <span>6 reviews</span>
          {%- endif -%}
        </div>
      </div>

      <div class="product-review-grid">
        {%- if review_total > 0 -%}
          {%- for block in section.blocks -%}
