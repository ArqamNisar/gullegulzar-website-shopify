      {%- when 'nesting-table-set-ns1' or 'ns1' -%}{%- assign fallback_image = 'ns1-room.jpg' -%}
      {%- when 'nesting-table-set-ns2' or 'ns2' -%}{%- assign fallback_image = 'ns2-room.jpg' -%}
      {%- when 'nesting-table-set-ns3' or 'ns3' -%}{%- assign fallback_image = 'ns3-room.jpg' -%}
      {%- when 'nesting-table-set-ns4' or 'ns4' -%}{%- assign fallback_image = 'ns4-room.jpg' -%}
      {%- when 'nesting-table-set-ns5' or 'ns5' -%}{%- assign fallback_image = 'ns5-room.jpg' -%}
      {%- when 'nesting-table-set-ns6' or 'ns6' -%}{%- assign fallback_image = 'ns6-room.jpg' -%}
      {%- when 'nesting-table-set-ns7' or 'ns7' -%}{%- assign fallback_image = 'ns7-room.jpg' -%}
      {%- when 'nesting-table-set-ns8' or 'ns8' -%}{%- assign fallback_image = 'ns8-room.jpg' -%}
      {%- when 'nesting-table-set-ns9' or 'ns9' -%}{%- assign fallback_image = 'ns9-room.jpg' -%}
      {%- when 'nesting-table-set-ns10' or 'ns10' -%}{%- assign fallback_image = 'ns10-room.jpg' -%}
      {%- when 'nesting-table-set-ns11' or 'ns11' -%}{%- assign fallback_image = 'ns11-room.jpg' -%}
      {%- when 'glass-nesting-table-set-nsg1' or 'nsg1' -%}{%- assign fallback_image = 'nsg1-room.jpg' -%}
      {%- when 'table-set-ts1' or 'ts1' -%}{%- assign fallback_image = 'ts1-room.jpg' -%}
      {%- when 'table-set-ts2' or 'ts2' -%}{%- assign fallback_image = 'ts2-room.jpg' -%}
      {%- when 'table-set-ts4' or 'ts4' -%}{%- assign fallback_image = 'ts4-room.jpg' -%}
      {%- when 'table-set-ts5' or 'ts5' -%}{%- assign fallback_image = 'ts5-room.jpg' -%}
      {%- when 'tea-trolley-tt1' or 'tt1' -%}{%- assign fallback_image = 'tt1-room.jpg' -%}
      {%- when 'tea-trolley-tt2' or 'tt2' -%}{%- assign fallback_image = 'tt2-room.jpg' -%}
      {%- when 'tea-trolley-tt3' or 'tt3' -%}{%- assign fallback_image = 'tt3-room.jpg' -%}
      {%- when 'tea-trolley-tt4' or 'tt4' -%}{%- assign fallback_image = 'tt4-room.jpg' -%}
      {%- when 'tea-trolley-tt5' or 'tt5' -%}{%- assign fallback_image = 'tt5-room.jpg' -%}
