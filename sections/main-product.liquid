{%- endif -%}
{%- if product != blank -%}
  {%- assign product_description = product.description -%}
  {%- if product_description == blank -%}
    {%- if product.handle == 'mini-coffee-table' -%}
      {%- assign product_description = 'A graceful two-tier accent table with a warm gold-finish frame and light marble-look surfaces.' -%}
    {%- else -%}
      {%- assign product_description = product_title -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign show_discount = false -%}
  {%- assign product_price = product.price | money -%}
  {%- assign product_unit_price = product.price | divided_by: 100.0 -%}
  {%- assign compare_price_raw = product.compare_at_price | default: 0 -%}
  {%- assign compare_price_display = blank -%}
  {%- assign discount_percent = 0 -%}
  {%- if compare_price_raw > product.price -%}
    {%- assign show_discount = true -%}
    {%- assign compare_price_display = compare_price_raw | money -%}
    {%- assign discount_percent = compare_price_raw | minus: product.price | times: 100.0 | divided_by: compare_price_raw | round -%}
  {%- endif -%}
  {%- if first_image != blank -%}
    {%- assign first_image_url = first_image | image_url: width: 1400 -%}
  {%- else -%}
