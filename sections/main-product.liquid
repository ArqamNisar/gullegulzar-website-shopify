{%- assign product_title = product.title | default: 'Mini Coffee Table' -%}
{%- assign first_image = product.featured_image -%}
{%- assign theme_product_image_names = blank -%}
{%- if product.handle == 'mini-coffee-table' or product.title == 'Mini Coffee Table' or product == blank -%}
  {%- assign theme_product_image_names = 'mini-room.jpg|mini-coffee.jpg' | split: '|' -%}
{%- elsif product.handle == 'gold-wheel-console' or product.title == 'Gold Wheel Console Trolley' -%}
  {%- assign theme_product_image_names = 'console-a2.jpg|console-a.jpg' | split: '|' -%}
{%- elsif product.handle == 'black-xframe-console' or product.title == 'Black Top X-Frame Console Table' -%}
  {%- assign theme_product_image_names = 'console-b.jpg|console-b2.jpg' | split: '|' -%}
{%- elsif product.handle == 'sunburst-console-table' or product.title == 'Sunburst Gold Console Table' -%}
  {%- assign theme_product_image_names = 'console-c2.jpg|console-c.jpg' | split: '|' -%}
{%- elsif product.handle == 'white-lattice-console' or product.title == 'White Top Lattice Console Table' -%}
  {%- assign theme_product_image_names = 'console-d.jpg' | split: '|' -%}
{%- elsif product.handle == 'fluted-pillar-center-table' or product.handle == 'ct1-fluted-center-table' or product.title contains 'Fluted Pillar' or product.handle == 'ct1' -%}
  {%- assign theme_product_image_names = 'ct1-room.jpg|ct1.jpg' | split: '|' -%}
{%- elsif product.handle == 'stepped-multitier-center-table' or product.handle == 'ct2-stepped-center-table' or product.title contains 'Stepped Multi-Tier' or product.handle == 'ct2' -%}
  {%- assign theme_product_image_names = 'ct2-room.jpg|ct2.jpg' | split: '|' -%}
{%- elsif product.handle == 'oval-ribbed-center-table' or product.handle == 'ct3-oval-center-table' or product.title contains 'Oval Ribbed' or product.handle == 'ct3' -%}
  {%- assign theme_product_image_names = 'ct3-room.jpg|ct3.jpg' | split: '|' -%}
{%- elsif product.handle == 'geometric-spiral-center-table' or product.handle == 'ct4-spiral-center-table' or product.title contains 'Geometric Spiral' or product.handle == 'ct4' -%}
  {%- assign theme_product_image_names = 'ct4-room.jpg|ct4.jpg' | split: '|' -%}
{%- endif -%}
{%- if product != blank -%}
  {%- assign product_description = product.description -%}
  {%- if product_description == blank -%}
    {%- if product.handle == 'mini-coffee-table' -%}
      {%- assign product_description = 'A graceful two-tier accent table with a warm gold-finish frame and light marble-look surfaces.' -%}
    {%- else -%}
      {%- assign product_description = product_title -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign show_discount = false -%}
  {%- assign product_price = product.price | money -%}
  {%- assign product_unit_price = product.price | divided_by: 100.0 -%}
  {%- assign compare_price_raw = product.compare_at_price | default: 0 -%}
  {%- assign compare_price_display = blank -%}
  {%- assign discount_percent = 0 -%}
  {%- if compare_price_raw > product.price -%}
    {%- assign show_discount = true -%}
    {%- assign compare_price_display = compare_price_raw | money -%}
    {%- assign discount_percent = compare_price_raw | minus: product.price | times: 100.0 | divided_by: compare_price_raw | round -%}
  {%- endif -%}
  {%- if first_image != blank -%}
    {%- assign first_image_url = first_image | image_url: width: 1400 -%}
  {%- else -%}
    {%- assign fallback_image = blank -%}
    {%- case product.handle -%}
      {%- when 'mini-coffee-table' -%}{%- assign fallback_image = 'mini-room.jpg' -%}
      {%- when 'gold-wheel-console' -%}{%- assign fallback_image = 'console-a2.jpg' -%}
      {%- when 'black-xframe-console' -%}{%- assign fallback_image = 'console-b.jpg' -%}
      {%- when 'sunburst-console-table' -%}{%- assign fallback_image = 'console-c2.jpg' -%}
      {%- when 'white-lattice-console' -%}{%- assign fallback_image = 'console-d.jpg' -%}
      {%- when 'fluted-pillar-center-table' or 'ct1-fluted-center-table' or 'ct1' -%}{%- assign fallback_image = 'ct1-room.jpg' -%}
      {%- when 'stepped-multitier-center-table' or 'ct2-stepped-center-table' or 'ct2' -%}{%- assign fallback_image = 'ct2-room.jpg' -%}
      {%- when 'oval-ribbed-center-table' or 'ct3-oval-center-table' or 'ct3' -%}{%- assign fallback_image = 'ct3-room.jpg' -%}
      {%- when 'geometric-spiral-center-table' or 'ct4-spiral-center-table' or 'ct4' -%}{%- assign fallback_image = 'ct4-room.jpg' -%}
    {%- endcase -%}
    {%- if fallback_image != blank -%}
      {%- assign first_image = fallback_image | asset_url -%}
      {%- assign first_image_url = first_image -%}
    {%- endif -%}
  {%- endif -%}
  {%- if theme_product_image_names != blank -%}
    {%- assign first_theme_image = theme_product_image_names | first -%}
    {%- assign first_image = first_theme_image | asset_url -%}
    {%- assign first_image_url = first_image -%}
  {%- endif -%}
{%- else -%}
  {%- assign show_discount = true -%}
  {%- assign product_price = 'Rs. 6,000' -%}
  {%- assign product_unit_price = 6000 -%}
  {%- assign compare_price_display = 'Rs. 7,000' -%}
  {%- assign discount_percent = 14 -%}
  {%- assign first_image = 'mini-room.jpg' | asset_url -%}
  {%- assign first_image_url = first_image -%}
  {%- assign product_description = 'A graceful two-tier accent table with a warm gold-finish frame and light marble-look surfaces.' -%}
{%- endif -%}
{%- assign room_image = 'mini-room.jpg' | asset_url -%}
{%- assign review_total = 0 -%}
{%- assign review_rating_sum = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.settings.content != blank -%}
    {%- assign review_total = review_total | plus: 1 -%}
    {%- assign review_rating_sum = review_rating_sum | plus: block.settings.rating -%}
  {%- endif -%}
{%- endfor -%}

<section class="section-spacing product-page-section">
  <div class="container">
    <nav class="product-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>
      <a href="/collections/all">Collections</a><span aria-hidden="true">/</span>
      <span aria-current="page">{{ product_title | escape }}</span>
    </nav>

    <div class="product-detail-layout product-detail-card">
      <!-- Gallery Column -->
      <div class="product-gallery">
        <div class="product-main-view product-main-image" data-zoom-image tabindex="0" role="group" aria-label="Product photo gallery. Use the arrow keys to change photos.">
          {%- if first_image_url != blank -%}
            <img id="product-main-image" src="{{ first_image_url }}" alt="{{ product_title | escape }} product photo" fetchpriority="high" width="1400" height="1400">
          {%- else -%}
            <div class="product-image-placeholder" role="img" aria-label="Product photos not available">Product photos coming soon</div>
          {%- endif -%}
          <button type="button" class="product-gallery-arrow product-gallery-arrow--previous" data-gallery-prev aria-label="Show previous product photo" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button type="button" class="product-gallery-arrow product-gallery-arrow--next" data-gallery-next aria-label="Show next product photo" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <span class="product-gallery-count" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            {%- if theme_product_image_names != blank -%}{{ theme_product_image_names.size }}
            {%- elsif product.images.size > 0 -%}{{ product.images.size }}
            {%- else -%}0{%- endif -%} photos
          </span>
          <span class="product-image-hint" aria-hidden="true">Hover to explore details</span>
        </div>
        <div class="product-thumbs" aria-label="Product photos">
          {%- if theme_product_image_names != blank -%}
            {%- for image_name in theme_product_image_names -%}
              {%- assign theme_image_url = image_name | asset_url -%}
              <button type="button" class="product-thumb-item{% if forloop.first %} active{% endif %}" data-image-src="{{ theme_image_url }}" aria-label="View {{ product_title | escape }} photo {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                <img src="{{ theme_image_url }}" alt="{{ product_title | escape }} photo {{ forloop.index }}" loading="lazy" width="240" height="240">
              </button>
            {%- endfor -%}
          {%- elsif product.images.size > 0 -%}
            {%- for image in product.images -%}
              <button type="button" class="product-thumb-item{% if image == first_image %} active{% endif %}" data-image-src="{{ image | image_url: width: 1400 }}" aria-label="View product photo {{ forloop.index }}" aria-pressed="{% if image == first_image %}true{% else %}false{% endif %}">
                {{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: product_title }}
              </button>
            {%- endfor -%}
          {%- else -%}
            <div class="product-image-placeholder product-image-placeholder--thumb">Product photos coming soon</div>
          {%- endif -%}
        </div>
      </div>

      <!-- Product Info Column -->
      <div class="product-info-wrap">

        <!-- 1. Brand Label & Eyebrow -->
        <div class="product-title-block">
          <span class="product-brand-label">GULL E GULZAR HOME TROLLEY</span>
          <h1 class="product-detail-title" id="MainProductTitle">{{ product_title | escape }}</h1>
          <div class="product-short-description">{{ product_description }}</div>
          <a class="product-review-jump" href="#customer-reviews" aria-label="Read customer reviews">
            {%- if review_total > 0 -%}
              <span>{{ review_total }} customer review{% unless review_total == 1 %}s{% endunless %}</span>
            {%- else -%}
              <span>4.9 out of 5 · 6 customer reviews</span>
            {%- endif -%}
          </a>
        </div>

        <div class="product-trust-marquee" aria-label="Shopping benefits">
          <div class="product-trust-track">
            <div class="product-trust-group">
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--gold" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
                <span class="ptb-label"><strong>Quality guaranteed</strong><small>Carefully crafted</small></span>
              </div>
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--purple" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg></span>
                <span class="ptb-label"><strong>100% authentic</strong><small>Original products</small></span>
              </div>
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--blue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v11H3zM14 10h4l3 3v5h-7z"/><circle cx="7.5" cy="19" r="1.5"/><circle cx="18" cy="19" r="1.5"/></svg></span>
                <span class="ptb-label"><strong>Free delivery</strong><small>Across Pakistan</small></span>
              </div>
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--green" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18m-14 5h4"/></svg></span>
                <span class="ptb-label"><strong>Secure checkout</strong><small>Shop with confidence</small></span>
              </div>
            </div>
            <div class="product-trust-group" aria-hidden="true">
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
                <span class="ptb-label"><strong>Quality guaranteed</strong><small>Carefully crafted</small></span>
              </div>
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg></span>
                <span class="ptb-label"><strong>100% authentic</strong><small>Original products</small></span>
              </div>
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v11H3zM14 10h4l3 3v5h-7z"/><circle cx="7.5" cy="19" r="1.5"/><circle cx="18" cy="19" r="1.5"/></svg></span>
                <span class="ptb-label"><strong>Free delivery</strong><small>Across Pakistan</small></span>
              </div>
              <div class="product-trust-badge">
                <span class="ptb-icon ptb-icon--green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18m-14 5h4"/></svg></span>
                <span class="ptb-label"><strong>Secure checkout</strong><small>Shop with confidence</small></span>
              </div>
            </div>
          </div>
        </div>

        <template>
          <div class="product-spec-ticker__track">
            <div class="product-spec-ticker__block">
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Two-Tier Round Accent Table Silhouette (Top &amp; Lower Shelf)</span>
              </div>
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Warm Gold-Finish Handcrafted Durable Metal Frame</span>
              </div>
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Light Marble-Look Elegant Tops &amp; Lower Storage Shelf</span>
              </div>
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Free Nationwide Delivery Across Pakistan &amp; 24hr Return Window</span>
              </div>
            </div>
            <!-- Seamless loop duplicate -->
            <div class="product-spec-ticker__block" aria-hidden="true">
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Two-Tier Round Accent Table Silhouette (Top &amp; Lower Shelf)</span>
              </div>
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Warm Gold-Finish Handcrafted Durable Metal Frame</span>
              </div>
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Light Marble-Look Elegant Tops &amp; Lower Storage Shelf</span>
              </div>
              <div class="product-spec-ticker__item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2L12 16.6l-6.3 4.4 2.3-7.2-6-4.4h7.6z"/></svg>
                <span>Free Nationwide Delivery Across Pakistan &amp; 24hr Return Window</span>
              </div>
            </div>
          </div>
        </template>

        <!-- 3. In Stock Indicator -->
        <div class="stock-status-indicator">
          <span class="status-pulse-dot" aria-hidden="true"></span>
          <span class="status-message"><strong>In stock</strong> — Order today for fast dispatch</span>
          <span class="stock-viewers-count">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <span data-live-viewers>14</span> people viewing
          </span>
        </div>

        <!-- 4. Price Section (Below In Stock and Above Add to Cart) -->
        <div class="product-price-section">
          <div class="price-wrapper product-price--main price--on-sale">
            <div class="price-container">
              <span class="price-item price-item--sale product-price-current" id="product-price-display" data-unit-price="{{ product_unit_price }}">
                {{ product_price }}
              </span>
              {%- if show_discount -%}
                <s class="price-item price-item--regular price-item--compare crossed-price-red">
                  {{ compare_price_display }}
                </s>
                <span class="badge-discount-percent">
                  -{{ discount_percent }}% OFF
                </span>
              {%- endif -%}
            </div>
          </div>
        </div>

        <!-- 5. Form with Quantity (+ -) and Add to Cart in a single line, followed by Buy Now -->
        {%- if product != blank -%}
          {% form 'product', product, id: 'MainProductForm', class: 'product-purchase-box' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

            <!-- + - signs and Add to cart button in a single line -->
            <div class="product-action-row">
              <div class="product-qty-wrap">
                <button type="button" class="qty-btn" id="qty-decrease" aria-label="Decrease quantity">−</button>
                <input type="number" id="Quantity" name="quantity" value="1" min="1" max="99" class="product-qty-input" aria-label="Product quantity">
                <button type="button" class="qty-btn" id="qty-increase" aria-label="Increase quantity">+</button>
              </div>
              <button type="submit" name="add" class="btn btn-primary btn-add-to-cart" id="btn-add-to-cart" {% unless product.available %}disabled{% endunless %}>
                {% render 'icon-cart' %}
                <span>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
              </button>
            </div>

            <!-- Below it: Buy Now button -->
            <div class="product-buy-now-row">
              <button type="submit" name="checkout" class="btn btn-dark btn-block product-buy-now-btn" id="btn-buy-now" {% unless product.available %}disabled{% endunless %}>
                Buy Now
              </button>
            </div>
          {% endform %}
        {%- else -%}
          <div class="product-purchase-box">
            <!-- + - signs and Add to cart button in a single line -->
            <div class="product-action-row">
              <div class="product-qty-wrap">
                <button type="button" class="qty-btn" id="qty-decrease" aria-label="Decrease quantity">−</button>
                <input type="number" id="Quantity" name="quantity" value="1" min="1" max="99" class="product-qty-input" aria-label="Product quantity">
                <button type="button" class="qty-btn" id="qty-increase" aria-label="Increase quantity">+</button>
              </div>
              <button type="button" class="btn btn-primary btn-add-to-cart" id="btn-add-to-cart">
                {% render 'icon-cart' %}
                <span>Add to Cart</span>
              </button>
            </div>

            <!-- Below it: Buy Now button -->
            <div class="product-buy-now-row">
              <button type="button" class="btn btn-dark btn-block product-buy-now-btn" id="btn-buy-now" onclick="document.getElementById('btn-add-to-cart').click(); window.location.href='/cart';">
                Buy Now
              </button>
            </div>
          </div>
        {%- endif -%}

        <!-- 6. Bundles (Below the Buy Now Button) -->
        <div class="product-bundle-selector" data-product-bundles>
          <div class="product-bundle-heading">
            <strong>Bundle &amp; Save</strong>
            <span>Bundle total updates automatically with your selection</span>
          </div>
          <div class="product-bundle-options">
            <button type="button" class="product-bundle-option active" data-bundle-qty="1" aria-pressed="true">
              <span class="bundle-badge">Starter</span>
              <strong>Buy 1 Piece</strong>
              <small data-bundle-option-price>{{ product_price }}</small>
            </button>
            <button type="button" class="product-bundle-option" data-bundle-qty="2" aria-pressed="false">
              <span class="bundle-badge bundle-badge--popular">Most Popular</span>
              <strong>Buy 2 Pieces</strong>
              <small data-bundle-option-price></small>
            </button>
            <button type="button" class="product-bundle-option" data-bundle-qty="3" aria-pressed="false">
              <span class="bundle-badge bundle-badge--best">Best Value</span>
              <strong>Buy 3 Pieces</strong>
              <small data-bundle-option-price></small>
            </button>
          </div>
          <p class="product-bundle-total"><span>Bundle Total:</span> <strong data-bundle-total>{{ product_price }}</strong></p>
        </div>

        <!-- 7. Delivery Timeline (as seen on miyaarwatches.com) -->
        <div class="delivery-estimate" aria-label="Estimated delivery timeline across Pakistan">
          <ol class="delivery-timeline">
            <li class="delivery-timeline__step">
              <span class="delivery-timeline__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h2l2.6 12.1a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L22 8H5"/><path d="M12 6v5m-2.5-2.5h5"/></svg>
              </span>
              <span class="delivery-timeline__title">Order Placed</span>
              <span class="delivery-timeline__label">Instant Confirmation</span>
            </li>
            <li class="delivery-timeline__step">
              <span class="delivery-timeline__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
