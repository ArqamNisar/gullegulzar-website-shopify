<!-- Exit Offer Modal (Discount coupon code, NO WhatsApp) -->
<dialog class="exit-offer-modal" data-exit-offer aria-labelledby="exit-offer-title">
  <button class="exit-offer-close" type="button" data-exit-offer-close aria-label="Close offer">×</button>
  <span class="exit-offer-kicker">A LITTLE SOMETHING EXTRA</span>
  <div class="exit-offer-badge">5%<small>OFF</small></div>
  <h2 id="exit-offer-title">Before you go...</h2>
  <p>Take an extra 5% off your order today. Use exclusive coupon code at checkout:</p>
  <div class="coupon-code-pill">
    <code>GULZAR5</code>
  </div>
  <button type="button" class="btn btn-primary btn-block" onclick="navigator.clipboard.writeText('GULZAR5'); this.textContent = 'Code Copied! Proceed to Cart'; setTimeout(() => window.location.href='/cart', 800);">
    Copy Code &amp; Checkout
  </button>
  <button type="button" class="exit-offer-dismiss" data-exit-offer-close>No thanks, continue browsing</button>
</dialog>

<!-- Sticky Add to Cart Bar (No WhatsApp) -->
<div class="product-sticky-bar" id="product-sticky-bar" aria-hidden="true">
  <div class="container">
    <div class="product-sticky-bar-inner">
      <div class="product-sticky-info">
        {%- if first_image_url != blank -%}
          <img src="{{ first_image_url }}" alt="{{ product_title | escape }}" width="44" height="44" class="sticky-product-thumb">
        {%- endif -%}
        <div>
          <span class="product-sticky-title">{{ product_title | escape }}</span>
          <span class="product-sticky-price" id="sticky-price-display">
            {{ product_price }}{%- if compare_price_display != blank -%} <s class="crossed-price-red" style="font-size: 0.85rem; margin-left: 5px;">{{ compare_price_display }}</s>{%- endif -%}
          </span>
        </div>
      </div>
      <div class="product-sticky-actions">
        <button type="button" class="btn btn-primary btn-sm product-sticky-add" id="sticky-add-btn">
          {% render 'icon-cart' %} Add to Cart
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product details",
  "settings": [],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "textarea", "id": "content", "label": "Review" },
        { "type": "text", "id": "date", "label": "Date (optional)" }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}