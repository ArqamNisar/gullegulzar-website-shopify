{%- assign wa_primary = settings.whatsapp_number_primary | default: '923204967079' -%}

<div class="section-spacing" style="background: var(--color-bg-body);">
  <div class="container" style="max-width: 850px;">
    <div class="section-header" style="text-align: left; margin-bottom: 2rem;">
      <span class="subheading">Shopping Basket</span>
      <h1 style="font-size: 2.5rem;">Your Selected Pieces</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        <div style="background: #FFFFFF; border-radius: var(--radius-md); border: 1px solid var(--color-border); padding: 1.5rem; margin-bottom: 2rem;">
          {%- for item in cart.items -%}
            <div class="shop-cart-item">
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-sm);">
              <div class="shop-cart-item-info">
                <h4>{{ item.product.title }}</h4>
                {%- unless item.variant.title == 'Default Title' -%}<div class="shop-cart-item-variant">{{ item.variant.title }}</div>{%- endunless -%}
                <div class="shop-cart-item-price">{{ item.final_price | money }}</div>
              </div>
              <div class="shop-cart-item-actions">
                <span class="shop-cart-quantity-label">Qty</span>
                <div class="cart-quantity-control" data-shopify-cart-quantity>
                  <button type="button" class="cart-quantity-step" data-cart-quantity-decrease aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
                  <input id="updates_{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="1" step="1" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}">
                  <button type="button" class="cart-quantity-step" data-cart-quantity-increase aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
                </div>
                <a class="shop-cart-remove" href="{{ item.url_to_remove }}" aria-label="Remove {{ item.product.title | escape }} from cart">Remove</a>
              </div>
            </div>
          {%- endfor -%}

          <button type="submit" name="update" class="btn btn-outline shop-cart-update">Update cart</button>
          <div style="padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 1.2rem; font-weight: 600;">Total Amount:</span>
            <span style="font-size: 1.5rem; font-weight: 700; color: var(--color-heading);">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <button type="submit" name="checkout" class="btn btn-primary btn-block" style="flex: 1; min-height: 50px; font-size: 1.05rem;">
            Proceed to Checkout
          </button>
          <a href="/collections/all" class="btn btn-outline" style="min-height: 50px; display: inline-flex; align-items: center; justify-content: center;">
            Continue Shopping
          </a>
        </div>
      </form>
    {%- else -%}
      <div style="background: #FFFFFF; padding: 3rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); text-align: center;">
        <h3 style="font-size: 1.6rem; margin-bottom: 0.5rem;">Your Cart is Currently Empty</h3>
        <p style="color: var(--color-muted); margin-bottom: 2rem;">Discover the Mini Coffee Table, thoughtfully styled for everyday living.</p>
        <a href="/collections/all" class="btn btn-primary">
          Explore All Furniture
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
