<section class="section-spacing category-section" style="background: #FFFFFF;">
  <div class="container">
    <div class="section-header">
      <span class="subheading">Our featured design</span>
      <h2>Mini Coffee Table</h2>
      <p>A graceful two-tier silhouette, a warm gold-finish frame, and light marble-look surfaces for everyday living.</p>
    </div>

    <div class="category-grid category-single-card">
      <a href="/products/mini-coffee-table" class="category-card">
        <div class="category-image-wrap">
          <img
            src="{{ 'mini-coffee.jpg' | asset_url }}"
            alt="Mini Coffee Table with a round, two-tier design and gold-finish frame"
            loading="lazy"
            width="1376"
            height="768"
          >
        </div>
        <div class="category-info">
          <div>
            <h3 class="category-name">Mini Coffee Table</h3>
            <span style="font-size: 0.8rem; color: var(--color-muted);">A considered accent for your home</span>
          </div>
          <div class="category-arrow">{% render 'icon-arrow' %}</div>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured design",
  "settings": [],
  "presets": [
    {
      "name": "Featured design"
    }
  ]
}
{% endschema %}
