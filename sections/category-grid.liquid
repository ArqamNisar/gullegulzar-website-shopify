            src="https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?auto=format&fit=crop&w=800&q=80" 
            alt="Tea Trolleys & Serving Carts - Gull e Gulzar"
            loading="lazy"
          >
        </div>
        <div class="category-info">
          <div>
            <h3 class="category-name">Tea Trolleys</h3>
            <span style="font-size: 0.8rem; color: var(--color-muted);">Luxury Serving Carts</span>
          </div>
          <div class="category-arrow">
            {% render 'icon-arrow' %}
          </div>
        </div>
      </a>

