{% comment %}
  Renders a product card
  Accepts:
  - product: {Object} Product Liquid object (optional)
  - title: {String} Fallback title
  - category: {String} Category title
  - price: {String} Price
  - compare_price: {String} Regular/Compare price
  - image_url: {String} Fallback image URL
  - badge: {String} Optional badge text ("Bestseller", "New", "Luxury")
  - url: {String} Target product page URL
{% endcomment %}

{%- assign item_title = title | default: product.title | default: "Luxury Designer Table" -%}
{%- assign item_category = category | default: product.type | default: "Home Trolley" -%}
{%- if price != blank -%}
  {%- assign item_price = price -%}
{%- elsif product != blank -%}
  {%- assign item_price = product.price | money -%}
{%- else -%}
  {%- assign item_price = "Rs. 18,500" -%}
{%- endif -%}
{%- if compare_price != blank -%}
  {%- assign item_compare = compare_price -%}
{%- elsif product.compare_at_price > product.price -%}
  {%- assign item_compare = product.compare_at_price | money -%}
{%- else -%}
  {%- assign item_compare = blank -%}
{%- endif -%}
{%- assign item_url = url | default: product.url | default: "/pages/contact" -%}
{%- if product != blank -%}
  {%- assign item_price_numeric = product.price | divided_by: 100.0 -%}
  {%- assign item_compare_numeric = product.compare_at_price | divided_by: 100.0 -%}
{%- else -%}
  {%- assign item_price_numeric = item_price | remove: 'Rs.' | remove: 'Rs ' | remove: 'Rs' | remove: ',' | strip | plus: 0 -%}
  {%- assign item_compare_numeric = item_compare | remove: 'Rs.' | remove: 'Rs ' | remove: 'Rs' | remove: ',' | strip | plus: 0 -%}
{%- endif -%}
{%- assign discount_amount = item_compare_numeric | minus: item_price_numeric -%}
{%- assign discount_percent = discount_amount | times: 100.0 | divided_by: item_compare_numeric | round -%}

<div class="product-card" data-product-title="{{ item_title }}" data-product-price="{{ item_price }}" data-product-image="{{ image_url | default: product.featured_image | image_url: width: 600 }}">
  <div class="product-media">
    {%- if item_compare_numeric > item_price_numeric and item_compare_numeric > 0 -%}
      <span class="product-tag tag-gold">{{ discount_percent }}% OFF</span>
    {%- elsif badge != blank -%}
      <span class="product-tag tag-gold">{{ badge }}</span>
    {%- endif -%}

    <a href="{{ item_url }}" aria-label="{{ item_title }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: item_title }}
      {%- elsif image_url != blank -%}
        <img src="{{ image_url }}" alt="{{ item_title }}" loading="lazy" width="600" height="600">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    <div class="product-quick-actions">
      <a href="{{ item_url }}" class="btn btn-dark btn-sm btn-block">
        View Product
      </a>
    </div>
  </div>

  <div class="product-content">
    <div class="product-category-hint">{{ item_category }}</div>
    <h3 class="product-title">
      <a href="{{ item_url }}">{{ item_title }}</a>
    </h3>

    <div class="product-rating">
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      <span>(5.0)</span>
    </div>

    <div class="product-price-row">
      <span class="product-price">{{ item_price }}</span>
      {%- if item_compare_numeric > item_price_numeric and item_compare_numeric > 0 -%}
        <span class="product-price-compare">{{ item_compare }}</span>
      {%- endif -%}
    </div>

    {%- if product != blank -%}
      <form method="post" action="/cart/add" class="product-actions-row">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn btn-primary btn-sm btn-block">{% render 'icon-cart' %} Add to Cart</button>
      </form>
    {%- else -%}
      <a href="{{ item_url }}" class="product-preview-link">View product <span aria-hidden="true">→</span></a>
    {%- endif -%}
  </div>
</div>
