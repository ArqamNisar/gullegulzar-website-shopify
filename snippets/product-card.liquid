{% comment %}
  Renders a product card
  Accepts:
  - product: {Object} Product Liquid object (optional)
  - title: {String} Fallback title
  - category: {String} Category title
  - price: {String} Price
  - compare_price: {String} Regular/Compare price
  - image_url: {String} Fallback image URL
  - image_filename: {String} Theme asset filename for the product image
  - url: {String} Target product page URL
{% endcomment %}

{%- assign item_title = title | default: product.title | default: "Luxury Designer Table" -%}
{%- assign item_category = category | default: product.type -%}
{%- if item_category == blank -%}
  {%- if product.handle contains 'center-table' or product.title contains 'Center Table' -%}
    {%- assign item_category = "Center Tables" -%}
  {%- elsif product.handle contains 'console' or product.title contains 'Console' -%}
    {%- assign item_category = "Console Tables" -%}
  {%- else -%}
    {%- assign item_category = "Coffee Table" -%}
  {%- endif -%}
{%- endif -%}

{%- if price != blank -%}
  {%- assign item_price = price -%}
{%- elsif product != blank -%}
  {%- assign item_price = product.price | money -%}
{%- else -%}
  {%- assign item_price = "Rs. 18,500" -%}
{%- endif -%}

{%- if compare_price != blank -%}
  {%- assign item_compare = compare_price -%}
{%- elsif product.compare_at_price > product.price -%}
  {%- assign item_compare = product.compare_at_price | money -%}
{%- else -%}
  {%- assign item_compare = blank -%}
{%- endif -%}

{%- assign item_url = url | default: product.url | default: "/pages/contact" -%}
{%- assign item_image_url = image_url -%}
{%- if image_filename != blank -%}
  {%- assign item_image_url = image_filename | asset_url -%}
{%- endif -%}

{%- if product != blank -%}
  {%- assign item_price_numeric = product.price | divided_by: 100.0 -%}
  {%- assign item_compare_numeric = product.compare_at_price | divided_by: 100.0 -%}
  {%- if item_image_url == blank and product.featured_image != blank -%}
    {%- assign item_image_url = product.featured_image | image_url: width: 600 -%}
  {%- endif -%}
{%- else -%}
  {%- assign item_price_numeric = item_price | remove: 'Rs.' | remove: 'Rs ' | remove: 'Rs' | remove: ',' | strip | plus: 0 -%}
  {%- assign item_compare_numeric = item_compare | remove: 'Rs.' | remove: 'Rs ' | remove: 'Rs' | remove: ',' | strip | plus: 0 -%}
{%- endif -%}

{%- if item_image_url == blank and product != blank -%}
  {%- case product.handle -%}
    {%- when 'fluted-pillar-center-table' -%}
      {%- assign item_image_url = 'ct1-room.jpg' | asset_url -%}
    {%- when 'oval-ribbed-center-table' -%}
      {%- assign item_image_url = 'ct2-room.jpg' | asset_url -%}
    {%- when 'stepped-multitier-center-table' -%}
      {%- assign item_image_url = 'ct3-room.jpg' | asset_url -%}
    {%- when 'geometric-spiral-center-table' -%}
      {%- assign item_image_url = 'ct4-room.jpg' | asset_url -%}
    {%- when 'birdcage-nesting-center-table-set' or 'cts1-nesting-center-table-set' -%}
      {%- assign item_image_url = 'cts1-room.jpg' | asset_url -%}
    {%- when 'bowed-cage-nesting-center-table-set' or 'cts2-nesting-center-table-set' -%}
      {%- assign item_image_url = 'cts2-room.jpg' | asset_url -%}
    {%- when 'crescent-nesting-center-table-set' or 'cts3-nesting-center-table-set' -%}
      {%- assign item_image_url = 'cts3-room.jpg' | asset_url -%}
    {%- when 'hourglass-mini-coffee-table' or 'mct2-mini-coffee-table' -%}
      {%- assign item_image_url = 'mct2-room.jpg' | asset_url -%}
    {%- when 'gold-wheel-console' -%}
      {%- assign item_image_url = 'console-a2.jpg' | asset_url -%}
    {%- when 'black-xframe-console' -%}
      {%- assign item_image_url = 'console-b.jpg' | asset_url -%}
    {%- when 'sunburst-console-table' -%}
      {%- assign item_image_url = 'console-c2.jpg' | asset_url -%}
    {%- when 'white-lattice-console' -%}
      {%- assign item_image_url = 'console-d.jpg' | asset_url -%}
    {%- when 'mini-coffee-table' -%}
      {%- assign item_image_url = 'mini-room.jpg' | asset_url -%}
  {%- endcase -%}
{%- endif -%}

{%- assign discount_amount = item_compare_numeric | minus: item_price_numeric -%}
{%- assign discount_percent = discount_amount | times: 100.0 | divided_by: item_compare_numeric | round -%}

<div class="product-card" data-product-title="{{ item_title }}" data-product-price="{{ item_price }}" data-product-image="{{ item_image_url }}">
  <div class="product-media">
    <a href="{{ item_url }}" aria-label="{{ item_title }}">
      {%- if item_image_url != blank -%}
        <img src="{{ item_image_url }}" alt="{{ item_title }}" loading="lazy" width="600" height="600">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    <div class="product-quick-actions">
      <a href="{{ item_url }}" class="btn btn-dark btn-sm btn-block">
        View Product
      </a>
    </div>
  </div>

  <div class="product-content">
    <div class="product-category-hint">{{ item_category }}</div>
    <h3 class="product-title">
      <a href="{{ item_url }}">{{ item_title }}</a>
    </h3>

    <div class="product-rating">
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      {% render 'icon-star' %}
      <span>(4.9) · 6 reviews</span>
    </div>

    <div class="product-price-row">
      <span class="product-price">{{ item_price }}</span>
      {%- if item_compare_numeric > item_price_numeric and item_compare_numeric > 0 -%}
        <span class="product-price-compare crossed-price-red">{{ item_compare }}</span>
        <span class="badge-discount-percent">{{ discount_percent }}% OFF</span>
      {%- endif -%}
    </div>

    {%- if product != blank -%}
      <form method="post" action="/cart/add" class="product-actions-row">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn btn-primary btn-sm btn-block">{% render 'icon-cart' %} Add to Cart</button>
      </form>
    {%- else -%}
      <a href="{{ item_url }}" class="product-preview-link">View product <span aria-hidden="true">→</span></a>
    {%- endif -%}
  </div>
</div>
